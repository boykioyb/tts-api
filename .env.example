# Copy to .env and adjust. docker-compose reads this automatically.

# --- TTS worker ---
TTS_BACKEND=onnx           # onnx (CPU, torch-free) | torch (GPU/CPU)
TTS_PRECISION=fp32         # onnx backend only
TTS_DEFAULT_VOICE=Phạm Tuyên
TTS_DEFAULT_STYLE=tu_nhien # tu_nhien | tin_tuc | doc_truyen
TTS_MAX_WORKERS=4

# --- Gateway ---
GATEWAY_REQUEST_TIMEOUT=120
# Host port the gateway is published on (container listens on 8000 internally).
GATEWAY_HOST_PORT=8600
# Absolute base URL the LucyLab-style JSON-RPC layer puts in the audio `url`.
# Must be reachable by the client that polls (e.g. the Auto-Create-Video tool).
# Point it at a LAN IP (e.g. http://192.168.1.50:8600) to expose beyond localhost.
GATEWAY_PUBLIC_BASE_URL=http://localhost:8600
GATEWAY_FILES_DIR=/tmp/tts-files
